---
import { createElement } from 'react';
import Site from '../layouts/Site.astro';
import { Demo } from '../components/Demo';
import { buildDemoPolicies } from '../demo-policy';
const policies = await buildDemoPolicies();
---

<Site
  title="Full demo"
  description="Explore twelve category rules on a fixed sample feed. All changes stay in this page session."
  page={createElement(Demo, { policies })}
>
  <script>
    import { mountDemo } from '../demo';
    try {
      mountDemo(document);
    } catch {
      document.querySelector('#demo-status')!.textContent =
        'The demo could not start. Reload the page to try again.';
    }
  </script>
</Site>
