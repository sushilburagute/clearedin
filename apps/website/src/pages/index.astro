---
import { createElement, Fragment as ReactFragment } from 'react';
import Site from '../layouts/Site.astro';
import { StudioHero, Studio, type StudioProps } from '../components/Studio';
import { CATEGORY_DEFINITION_BY_ID } from '@clearedin/taxonomy';
import { SYNTHETIC_FIXTURES } from '@clearedin/test-fixtures/fake-classifier';
import { buildDemoPolicies } from '../demo-policy';
const policies = await buildDemoPolicies();
const samples = [
  ['engagement-bait', 'engagement_bait', 'chat', 'Leo Park', 'Growth marketer'],
  [
    'job-referral',
    'job_posting',
    'briefcase',
    'Mira Shah',
    'Engineering manager',
  ],
  [
    'technical-launch',
    'technical_content',
    'code',
    'Jules Chen',
    'Compiler engineer',
  ],
  [
    'consulting-milestone',
    'promotion',
    'spark',
    'Alex Reed',
    'Independent database consultant',
  ],
] as const;
const props: StudioProps = {
  posts: samples.map(([id, category, icon, author, role]) => ({
    id,
    category,
    icon,
    author,
    role,
    label: CATEGORY_DEFINITION_BY_ID[category].label,
    text: SYNTHETIC_FIXTURES.find((post) => post.id === id)!.text.replace(
      '[Synthetic example] ',
      '',
    ),
    policy: policies.get(id)!,
  })),
};
const page = createElement(
  ReactFragment,
  null,
  createElement(StudioHero),
  createElement(
    'div',
    { id: 'studio-root', 'data-studio': JSON.stringify(props) },
    createElement(Studio, props),
  ),
);
---

<Site
  title="Choose what you see on LinkedIn"
  description="Try ClearedIn on a sample feed. Keep job openings visible, hide engagement bait, and reveal any post. No LinkedIn account or extension needed."
  page={page}
>
  <script>
    import { createElement } from 'react';
    import { hydrateRoot } from 'react-dom/client';
    import { Studio, type StudioProps } from '../components/Studio';
    const root = document.getElementById('studio-root')!;
    const props = JSON.parse(root.dataset.studio!) as StudioProps;
    hydrateRoot(root, createElement(Studio, props));
  </script>
</Site>
