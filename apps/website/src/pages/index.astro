---
import { createElement } from 'react';
import { getImage } from 'astro:assets';
import studioPhoto from '../assets/studio.jpg';
import Site from '../layouts/Site.astro';
import { Studio, type StudioProps } from '../components/Studio';
import { CATEGORY_DEFINITION_BY_ID } from '@clearedin/taxonomy';
import { SYNTHETIC_FIXTURES } from '@clearedin/test-fixtures/fake-classifier';
import { buildDemoPolicies } from '../demo-policy';
const policies = await buildDemoPolicies();
const samples = [
  [
    'job-referral',
    'job_posting',
    'briefcase',
    'Mira Shah',
    'Engineering manager',
  ],
  ['engagement-bait', 'engagement_bait', 'chat', 'Leo Park', 'Growth marketer'],
  [
    'technical-launch',
    'technical_content',
    'code',
    'Jules Chen',
    'Compiler engineer',
  ],
  [
    'consulting-milestone',
    'promotion',
    'spark',
    'Alex Reed',
    'Independent database consultant',
  ],
] as const;
const photo = await getImage({
  src: studioPhoto,
  widths: [384, 640, 960],
  format: 'webp',
  quality: 72,
});
const props: StudioProps = {
  image: { src: photo.src, srcSet: photo.srcSet.attribute },
  posts: samples.map(([id, category, icon, author, role]) => ({
    id,
    category,
    icon,
    author,
    role,
    label: CATEGORY_DEFINITION_BY_ID[category].label,
    text: SYNTHETIC_FIXTURES.find((post) => post.id === id)!.text.replace(
      '[Synthetic example] ',
      '',
    ),
    policy: policies.get(id)!,
  })),
};
const page = createElement(Studio, props);
---

<Site
  title="Try the sample feed"
  description="Try ClearedIn on a sample feed. Keep job openings visible, hide engagement bait, and reveal any post. No LinkedIn account or extension needed."
  page={page}
>
  <script>
    import { mountStudio } from '../studio';
    mountStudio(document);
  </script>
</Site>
